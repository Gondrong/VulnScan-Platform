# ─── Security ───────────────────────────────────────────────────────────────
# CHANGE THIS before deploying! Use: openssl rand -hex 32
SECRET_KEY=4f553ffd685b6b80033e1f67e4f7bf63f7c9f00e9b3564ca3bb1975a9222d6f7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password

# ─── Scan Settings ───────────────────────────────────────────────────────────
# Allowlist: comma-separated CIDR ranges and domain suffixes
# Targets must match to be scanned (security control)
ALLOWLIST=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,127.0.0.0/8,.internal.local,.example.com,.local

# Per-request timeout for individual HTTP requests within plugins (seconds)
# Was 10800 (3 hours) — way too high, causes plugins to hang on slow targets
SCAN_TIMEOUT_SECONDS=30

# Global scan budget: max wall-clock time for ALL plugins combined (seconds)
# Must be less than RQ job_timeout (budget + 300s headroom)
# 900s (15 min) is good for most targets
SCAN_BUDGET_SECONDS=900

REPORTS_DIR=/data/reports

# ─── NVD API Key (optional) ────────────────────────────────────────────────
# Get a free key at: https://nvd.nist.gov/developers/request-an-api-key
# With key: 0.6s rate limit (fast). Without: 6s rate limit (slow).
NVD_API_KEY= b3fa2441-8e53-4c37-a1a9-350538183064

# ─── AI Providers (configure at least one for AI Deep Analysis) ──────────────
# Azure OpenAI — get from Azure Portal → your OpenAI resource → Keys & Endpoint
AZURE_OPENAI_API_KEY={{YOUR_KEY}}
AZURE_OPENAI_ENDPOINT={{YOUR_URL}}
AZURE_OPENAI_DEPLOYMENT={{YOUR_MODEL}}
AZURE_OPENAI_API_VERSION={{YOUR_MODEL_VERSION}}

# Claude CLI — path to claude binary (if installed on server)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_ENABLED=true

# Google Gemini — get from https://aistudio.google.com/apikey
GEMINI_API_KEY={{YOUR_KEY}}
GEMINI_MODEL={{YOUR_MODEL}}

# ─── Admin defaults (change on first run) ────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_WORKSPACE=default

# ─── Frontend / API URLs ─────────────────────────────────────────────────────
# Set VITE_API_URL to the address reachable from the browser.
# For local dev: http://localhost:8888
# For LAN access from another machine: http://<your-host-ip>:8888
VITE_API_URL=http://localhost:8888

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8888
FRONTEND_PORT=5173

