# ─── Security ───────────────────────────────────────────────────────────────
# CHANGE THIS before deploying! Use: openssl rand -hex 32
SECRET_KEY=4f553ffd685b6b80033e1f67e4f7bf63f7c9f00e9b3564ca3bb1975a9222d6f7

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password

# ─── Scan Settings ───────────────────────────────────────────────────────────
# Allowlist: comma-separated CIDR ranges and domain suffixes
# Targets must match to be scanned (security control)
ALLOWLIST=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,127.0.0.0/8,.internal.local,.example.com,.local

# Per-request timeout for individual HTTP requests within plugins (seconds)
# Was 10800 (3 hours) — way too high, causes plugins to hang on slow targets
SCAN_TIMEOUT_SECONDS=30

# Global scan budget: max wall-clock time for ALL plugins combined (seconds)
# Must be less than RQ job_timeout (budget + 300s headroom)
# 900s (15 min) is good for most targets
SCAN_BUDGET_SECONDS=900

# Number of concurrent scan workers (each handles one scan at a time)
# Set to 2-4 to run multiple scans in parallel
SCAN_WORKERS=2

REPORTS_DIR=/data/reports

# ─── NVD API Key (optional) ────────────────────────────────────────────────
# Get a free key at: https://nvd.nist.gov/developers/request-an-api-key
# With key: 0.6s rate limit (fast). Without: 6s rate limit (slow).
NVD_API_KEY=b3fa2441-8e53-4c37-a1a9-350538183064

# ─── AI Providers (configure at least one for AI Deep Analysis) ──────────────
# Azure OpenAI — get from Azure Portal → your OpenAI resource → Keys & Endpoint
AZURE_OPENAI_API_KEY={{YOUR_KEY}}
AZURE_OPENAI_ENDPOINT={{YOUR_URL}}
AZURE_OPENAI_DEPLOYMENT={{YOUR_MODEL}}
AZURE_OPENAI_API_VERSION={{YOUR_MODEL_VERSION}}

# Claude CLI — path to claude binary (if installed on server)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_ENABLED=true
# CLAUDE_PROFILE_DIR is the HOST path bind-mounted to /root/.claude.
# CLAUDE_CONFIG_DIR is read by the Claude CLI *inside* the container and must be
# the container-side path. Do not merge these two: CLAUDE_CONFIG_DIR is the
# CLI's own variable, so giving it a host path (worse, a relative one) makes the
# CLI store its profile relative to its working directory instead of in the
# mount — which is exactly what happened before.
CLAUDE_CONFIG_DIR=/root/.claude

# Host directory holding the Claude CLI profile, mounted into the containers at
# /root/.claude. This is a profile dedicated to the platform, NOT a shared one:
#   * Log in from inside the container:
#       docker compose exec -it worker-ai claude
#     then run /login and follow the browser flow (same Pro/Max account is fine).
#   * A separate login gets its own token pair, so it never fights over refresh
#     tokens with the CLI you use in your own terminal.
#   * Do not point this at your personal ~/.claude — the container runs as root
#     and would rewrite .credentials.json as root-owned on every token refresh,
#     breaking your own CLI.
#   * The profile must be written by the SAME CLI major version as the container
#     (see CLAUDE_CLI_VERSION in backend/Dockerfile). A v2-written profile is
#     unreadable by a v1 CLI: "Invalid API key - Please run /login".
CLAUDE_PROFILE_DIR=./data/claude-config

# Long-lived OAuth token for headless/container use (works with a Pro/Max
# subscription — no API key needed). Generate it ON THE HOST, in a real
# terminal with a browser available:
#     claude setup-token
# then paste the resulting token here. The containers read it from this file,
# so the CLI needs no interactive login and no shared profile.
#   WARNING: this is a credential. `.env` is currently TRACKED BY GIT in this
#   repo — run `git rm --cached .env` before putting a token here, or it gets
#   committed.
# Leave EMPTY when authenticating by profile login: a stale token here
# overrides the profile and every call fails with 401.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── AI analysis timeouts (seconds) ──────────────────────────────────────────
# Ordering is enforced: AI_CLI_TIMEOUT < AI_ANALYSIS_TIMEOUT < AI_STALE_AFTER_SECONDS
# AI_CLI_TIMEOUT         budget for ONE provider call       (derived: (job-300)/2)
# AI_ANALYSIS_TIMEOUT    RQ job_timeout for the whole task   (default 2700)
# AI_STALE_AFTER_SECONDS watchdog limit, measured from start (derived: job+600)
# The validate_then_exploit mode makes two calls in one job. Measured on 88
# findings: stage 1 ~180s, stage 2 ~600s — 1800s left too little headroom.
AI_ANALYSIS_TIMEOUT=2700
# Number of parallel AI workers — 1 meant analyses queued up behind each other.
AI_WORKERS=2

# Google Gemini — get from https://aistudio.google.com/apikey
GEMINI_API_KEY={{YOUR_KEY}}
GEMINI_MODEL={{YOUR_MODEL}}

# ─── Admin defaults (change on first run) ────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_WORKSPACE=default

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use "*" only for development.
# Example: http://localhost:5173,https://vulnscan.yourcompany.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8888

# ─── Frontend / API URLs ─────────────────────────────────────────────────────
# Set VITE_API_URL to the address reachable from the browser.
# For local dev: http://localhost:8888
# For LAN access from another machine: http://<your-host-ip>:8888
VITE_API_URL=http://localhost:8888

# ─── CVE.org CVSS fetch tuning ───────────────────────────────────────────────
# Increase if CVE.org refresh times out. Default timeout is 7200s (2 hours).
CVEORG_WORKERS=8
CVEORG_REQ_PER_SEC=10

# ─── Ports ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8888
FRONTEND_PORT=5173

