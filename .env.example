# VulnScan Platform — example configuration
#
# Copy to .env, then fill in every blank value:
#
#     cp .env.example .env
#
# .env must NOT be committed (see .gitignore). This file is the one that goes
# in the repo. Values already filled in below are defaults that are safe to
# share; blank ones you must supply yourself.


# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Signing key for JWTs and sessions. REQUIRED, at least 32 random characters.
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# PostgreSQL DSN used by the backend and all three workers.
# Host "db" is the service name in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

REDIS_URL=redis://redis:6379/0

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_AUTH must match NEO4J_USER/NEO4J_PASSWORD above; the Neo4j container
# reads this variable, not the two separate ones.
NEO4J_AUTH=neo4j/CHANGE_ME


# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------

# Comma-separated hosts/CIDRs that may be scanned. Targets outside this list
# are rejected. The default below is the RFC 5737 documentation range, so a
# fresh copy of this file cannot scan a real network by accident — replace it
# with your own range before the first scan.
ALLOWLIST=127.0.0.1,localhost,192.0.2.0/24

# These timeouts MUST stay in ascending order. Inverting any of them causes
# failures that look like something else entirely:
#
#   SCAN_TIMEOUT_SECONDS < SCAN_BUDGET_SECONDS < SCAN_JOB_TIMEOUT < SCAN_STALE_AFTER_SECONDS
#      per request            engine budget          RQ SIGKILL            watchdog
#
SCAN_TIMEOUT_SECONDS=30
SCAN_BUDGET_SECONDS=900
# Defaults to SCAN_BUDGET_SECONDS + 600. Set only to override. RQ sends SIGKILL
# at this point, and a SIGKILLed scan loses every finding it had collected, so
# the margin is deliberately generous.
#SCAN_JOB_TIMEOUT=1500
# Defaults to SCAN_JOB_TIMEOUT + 300. Must exceed SCAN_JOB_TIMEOUT: a SIGKILLed
# process never gets to write its own status, and without the watchdog its row
# would sit at "running" forever.
#SCAN_STALE_AFTER_SECONDS=1800

SCAN_WORKERS=2
REPORTS_DIR=/data/reports

# Proxy ranges trusted when reading X-Forwarded-For. Do not include a range a
# client can reach, or the origin address used by the rate limiter and the
# audit log can be spoofed too.
#TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12


# ---------------------------------------------------------------------------
# Datasets / threat intel
# ---------------------------------------------------------------------------

# NVD API key. Without one, the request rate is throttled far harder.
# Free registration: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# The NVD refresh is resumable: each page is written to disk, and a refresh
# that fails midway continues from the last valid page.
#NVD_PAGE_SIZE=200
#NVD_PAGE_TIMEOUT=120
# A manifest older than this is treated as stale and the refresh restarts.
#NVD_RESUME_MAX_AGE_HOURS=48

CVEORG_WORKERS=8
CVEORG_REQ_PER_SEC=10


# ---------------------------------------------------------------------------
# AI providers — fill in only the ones you use
# ---------------------------------------------------------------------------

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude CLI (Pro/Max subscription, not the API).
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_ENABLED=true
# CLAUDE_CONFIG_DIR is the Claude CLI's OWN environment variable, and .env is
# passed into the containers via env_file. It must be the *container* path.
# Given a host path, the CLI stores its profile relative to its working
# directory instead of in the mount.
CLAUDE_CONFIG_DIR=/root/.claude
# The HOST path that gets mounted at CLAUDE_CONFIG_DIR.
CLAUDE_PROFILE_DIR=./data/claude-config
# LEAVE EMPTY when authenticating by profile login. A stale token here
# overrides a perfectly valid profile, and every call fails 401.
CLAUDE_CODE_OAUTH_TOKEN=

# AI timeouts, also in ascending order:
#
#   AI_CLI_TIMEOUT < AI_ANALYSIS_TIMEOUT < AI_STALE_AFTER_SECONDS
#     per call           RQ job budget           watchdog
#
AI_ANALYSIS_TIMEOUT=2700
#AI_CLI_TIMEOUT=600
#AI_STALE_AFTER_SECONDS=3300

AI_WORKERS=2

# Findings per batch sent to the model. Must stay at or below
# prompts.MAX_FULL_DETAIL. Above it, findings past the limit are sent as
# title-only summaries with no evidence, and the model validates them on the
# title alone.
#AI_BATCH_SIZE=30

# Reasoning models bill their reasoning trace against max_tokens. Too low and
# the reply comes back empty or cut mid-JSON. Compare models only at the same
# AI_MAX_TOKENS and batch size.
#AI_MAX_TOKENS=16384


# ---------------------------------------------------------------------------
# Bootstrap account
# ---------------------------------------------------------------------------

# Created once, while the database is still empty. Change the password after
# the first login, then blank the value below again.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_WORKSPACE=default


# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Match the host the frontend is served from. Wildcards are not supported when
# credentials are sent.
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8888

BACKEND_PORT=8888
FRONTEND_PORT=5173
