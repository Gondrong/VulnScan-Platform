#!/usr/bin/env python3
"""
fast_update_datasets.py — Parallel dataset fetcher for VulnScan Platform.

Speeds up dataset updates by:
  1. Fetching NVD pages concurrently (5-10x faster)
  2. Fetching CVEDetails.com in parallel batches
  3. Running CISA KEV + EPSS downloads concurrently with NVD

Usage:
  python3 scripts/fast_update_datasets.py

  # With NVD API key (recommended — 10x faster):
  NVD_API_KEY=your-key python3 scripts/fast_update_datasets.py

  # Custom options:
  python3 scripts/fast_update_datasets.py --nvd-days 90 --workers 8 --skip-cvedetails

Environment variables (same as update_datasets.sh):
  NVD_API_KEY        Free key from https://nvd.nist.gov/developers/request-an-api-key
  NVD_DAYS           Days of history to fetch (default: 120)
  CVEDETAILS_API_KEY Optional API key for CVEDetails.com
"""

import argparse
import concurrent.futures
import gzip
import json
import logging
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
from datetime import datetime, timedelta, timezone
from pathlib import Path

logging.basicConfig(
    level=logging.INFO,
    format="\033[1;32m[update]\033[0m %(message)s",
)
logger = logging.getLogger("fast_update")


# ═══════════════════════════════════════════════════════════════════════════════
# CONFIG
# ═══════════════════════════════════════════════════════════════════════════════

ROOT_DIR = Path(__file__).resolve().parent.parent
RAW_NVD = ROOT_DIR / "data" / "raw" / "nvd"
RAW_CISA = ROOT_DIR / "data" / "raw" / "cisa"
RAW_EPSS = ROOT_DIR / "data" / "raw" / "epss"
OUT_DIR = ROOT_DIR / "data" / "cve"

NVD_API_BASE = os.environ.get("NVD_API_BASE", "https://services.nvd.nist.gov/rest/json/cves/2.0")
CISA_KEV_URL = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
EPSS_URL = "https://epss.cyentia.com/epss_scores-current.csv.gz"


def fetch_url(url, headers=None, timeout=30):
    """Fetch a URL and return the response body as bytes."""
    req = urllib.request.Request(url, headers=headers or {})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


# ═══════════════════════════════════════════════════════════════════════════════
# NVD FETCHER (parallel pages)
# ═══════════════════════════════════════════════════════════════════════════════

def fetch_nvd_page(page_num, start_idx, page_size, start_date, end_date, api_key, rate_delay):
    """Fetch a single NVD API page. Returns (page_num, data_dict)."""
    headers = {"Accept": "application/json"}
    if api_key:
        headers["apiKey"] = api_key

    params = (
        f"?pubStartDate={start_date}&pubEndDate={end_date}"
        f"&startIndex={start_idx}&resultsPerPage={page_size}"
    )
    url = NVD_API_BASE + params

    # Rate limit courtesy
    if page_num > 1:
        time.sleep(rate_delay)

    try:
        data = fetch_url(url, headers, timeout=60)
        result = json.loads(data)
        vulns = len(result.get("vulnerabilities", []))
        total = result.get("totalResults", 0)
        logger.info("  NVD page %d: %d vulns (total=%d)", page_num, vulns, total)
        return page_num, result
    except Exception as e:
        logger.error("  NVD page %d failed: %s", page_num, e)
        return page_num, None


def fetch_nvd_parallel(nvd_days, api_key, max_workers=5):
    """Fetch all NVD pages in parallel. Returns list of raw JSON dicts."""
    end_date = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000")
    start_date = (datetime.now(timezone.utc) - timedelta(days=nvd_days)).strftime("%Y-%m-%dT%H:%M:%S.000")

    rate_delay = 0.6 if api_key else 6.0
    # With API key we can do parallel; without, we must be sequential
    workers = max_workers if api_key else 1

    if not api_key:
        logger.warning("No NVD_API_KEY — fetching sequentially (6s delay). Get a free key at:")
        logger.warning("  https://nvd.nist.gov/developers/request-an-api-key")

    logger.info("Fetching NVD CVEs (last %d days, %d workers)...", nvd_days, workers)
    logger.info("  Date range: %s -> %s", start_date, end_date)

    page_size = 2000

    # First, fetch page 1 to get totalResults
    _, first_page = fetch_nvd_page(1, 0, page_size, start_date, end_date, api_key, 0)
    if not first_page:
        logger.error("Failed to fetch first NVD page")
        return []

    total = first_page.get("totalResults", 0)
    logger.info("  Total CVEs available: %d", total)
    pages = [first_page]

    if total <= page_size:
        return pages

    # Calculate remaining pages
    remaining_starts = list(range(page_size, total, page_size))
    logger.info("  Fetching %d more pages with %d workers...", len(remaining_starts), workers)

    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = {
            pool.submit(
                fetch_nvd_page, i + 2, start_idx, page_size,
                start_date, end_date, api_key, rate_delay
            ): i
            for i, start_idx in enumerate(remaining_starts)
        }

        for future in concurrent.futures.as_completed(futures):
            _, result = future.result()
            if result:
                pages.append(result)

    logger.info("  NVD fetch complete: %d pages", len(pages))
    return pages


# ═══════════════════════════════════════════════════════════════════════════════
# CISA KEV + EPSS (concurrent with NVD)
# ═══════════════════════════════════════════════════════════════════════════════

def fetch_cisa_kev():
    """Fetch CISA KEV catalog."""
    logger.info("Fetching CISA KEV...")
    try:
        data = fetch_url(CISA_KEV_URL, timeout=30)
        out = RAW_CISA / "known_exploited_vulnerabilities.json"
        out.write_bytes(data)
        logger.info("  CISA KEV: %d bytes", len(data))
        return True
    except Exception as e:
        logger.error("  CISA KEV failed: %s", e)
        return False


def fetch_epss():
    """Fetch EPSS scores."""
    logger.info("Fetching EPSS...")
    try:
        data = fetch_url(EPSS_URL, timeout=60)
        csv_data = gzip.decompress(data)
        out = RAW_EPSS / "epss_scores-current.csv"
        out.write_bytes(csv_data)
        logger.info("  EPSS: %d bytes (decompressed)", len(csv_data))
        return True
    except Exception as e:
        logger.error("  EPSS failed: %s", e)
        return False


# ═══════════════════════════════════════════════════════════════════════════════
# CVEDETAILS FETCHER (parallel batches)
# ═══════════════════════════════════════════════════════════════════════════════

def fetch_cvedetails_single(cve_id, api_key=None):
    """Fetch CVSS from CVEDetails.com for a single CVE."""
    if api_key:
        url = f"https://www.cvedetails.com/api/v1/vulnerability/{cve_id}"
        headers = {"Authorization": f"Bearer {api_key}", "Accept": "application/json"}
    else:
        url = f"https://www.cvedetails.com/cve/{cve_id}/"
        headers = {
            "User-Agent": "VulnScan-Platform/1.0",
            "Accept": "text/html",
        }

    try:
        data = fetch_url(url, headers, timeout=10)
        text = data.decode("utf-8", errors="ignore")

        if api_key:
            d = json.loads(text)
            score = d.get("cvssScore") or d.get("cvss3_score")
        else:
            # Parse HTML for CVSS
            score = None
            for pattern in [
                r'cvss[_-]?score["\s:>]*([0-9]+\.?[0-9]*)',
                r'class="cvssbox"[^>]*>([0-9]+\.?[0-9]*)',
            ]:
                m = re.search(pattern, text, re.IGNORECASE)
                if m:
                    score = float(m.group(1))
                    break

        if score and 0 < float(score) <= 10:
            score = float(score)
            sev = "critical" if score >= 9 else "high" if score >= 7 else "medium" if score >= 4 else "low" if score > 0 else "info"
            return cve_id, {"cvss": score, "severity": sev}
    except Exception:
        pass

    return cve_id, None


def fetch_cvedetails_parallel(cve_ids, api_key=None, max_workers=3, delay=1.5):
    """Fetch CVEDetails data for multiple CVEs in parallel batches."""
    if not cve_ids:
        return {}

    logger.info("Fetching CVEDetails.com for %d CVEs (%d workers)...", len(cve_ids), max_workers)

    results = {}
    fetched = 0
    failed = 0

    # Process in batches to respect rate limits
    batch_size = max_workers
    for batch_start in range(0, len(cve_ids), batch_size):
        batch = cve_ids[batch_start:batch_start + batch_size]

        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as pool:
            futures = {
                pool.submit(fetch_cvedetails_single, cve_id, api_key): cve_id
                for cve_id in batch
            }
            for future in concurrent.futures.as_completed(futures):
                cve_id, result = future.result()
                if result:
                    results[cve_id] = result
                    fetched += 1
                else:
                    failed += 1

        # Rate limit between batches
        if batch_start + batch_size < len(cve_ids):
            time.sleep(delay)

        if (batch_start + batch_size) % 50 == 0:
            logger.info("  CVEDetails progress: %d/%d", batch_start + batch_size, len(cve_ids))

    logger.info("  CVEDetails: %d fetched, %d failed", fetched, failed)
    return results


# ═══════════════════════════════════════════════════════════════════════════════
# DATA CONVERSION (reuse existing scripts)
# ═══════════════════════════════════════════════════════════════════════════════

def run_script(name, args):
    """Run a Python script from the scripts directory."""
    script = ROOT_DIR / "scripts" / name
    if not script.exists():
        logger.warning("Script not found: %s", script)
        return False
    try:
        result = subprocess.run(
            [sys.executable, str(script)] + args,
            capture_output=True, text=True, timeout=120,
        )
        if result.returncode != 0:
            logger.error("%s failed: %s", name, result.stderr[:500])
            return False
        if result.stdout.strip():
            for line in result.stdout.strip().split("\n"):
                logger.info("  %s", line)
        return True
    except Exception as e:
        logger.error("%s error: %s", name, e)
        return False


def flatten_nvd(nvd_pages):
    """Save raw NVD pages and run the flattener."""
    if not nvd_pages:
        return False

    # Save raw pages
    for i, page in enumerate(nvd_pages, 1):
        out = RAW_NVD / f"nvd_api_page_{i}.json"
        with open(out, "w") as f:
            json.dump(page, f)

    input_files = [str(RAW_NVD / f"nvd_api_page_{i}.json") for i in range(1, len(nvd_pages) + 1)]
    out_file = str(OUT_DIR / "nvd_cpe_cve.json")

    logger.info("Flattening NVD (%d pages) -> %s", len(nvd_pages), out_file)
    return run_script("nvd_flatten.py", ["--inputs"] + input_files + ["--out", out_file])


def convert_kev():
    """Convert CISA KEV to platform format."""
    raw = RAW_CISA / "known_exploited_vulnerabilities.json"
    if not raw.exists():
        return False
    out = str(OUT_DIR / "cisa_kev.json")
    logger.info("Converting CISA KEV -> %s", out)
    return run_script("cisa_kev_convert.py", ["--in", str(raw), "--out", out])


def convert_epss():
    """Convert EPSS to platform format."""
    raw = RAW_EPSS / "epss_scores-current.csv"
    if not raw.exists():
        return False
    out = str(OUT_DIR / "epss.json")
    logger.info("Converting EPSS -> %s", out)
    return run_script("epss_convert.py", ["--in", str(raw), "--out", out])


def generate_cms_map():
    """Generate CMS CVE map."""
    nvd = OUT_DIR / "nvd_cpe_cve.json"
    if not nvd.exists():
        return False
    out = str(OUT_DIR / "cms_cve_map.json")
    logger.info("Generating CMS CVE map -> %s", out)
    return run_script("generate_cms_cve_map.py", ["--nvd", str(nvd), "--out", out])


def generate_compliance_map():
    """Generate compliance map."""
    out = str(OUT_DIR / "compliance_map.json")
    logger.info("Generating compliance map -> %s", out)
    return run_script("generate_compliance_map.py", ["--out", out])


# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser(description="Fast parallel dataset updater")
    ap.add_argument("--nvd-days", type=int, default=int(os.environ.get("NVD_DAYS", 120)))
    ap.add_argument("--workers", type=int, default=5, help="Parallel workers for NVD (default: 5)")
    ap.add_argument("--skip-cvedetails", action="store_true", help="Skip CVEDetails fetch")
    ap.add_argument("--cvedetails-max", type=int, default=0, help="Max CVEs to fetch from CVEDetails (0=all)")
    ap.add_argument("--cvedetails-workers", type=int, default=3, help="Parallel workers for CVEDetails")
    args = ap.parse_args()

    api_key = os.environ.get("NVD_API_KEY", "")
    cd_api_key = os.environ.get("CVEDETAILS_API_KEY", "")

    # Create directories
    for d in [RAW_NVD, RAW_CISA, RAW_EPSS, OUT_DIR]:
        d.mkdir(parents=True, exist_ok=True)

    start_time = time.time()

    # ── Phase 1: Parallel fetch (NVD + CISA + EPSS concurrently) ──
    logger.info("=" * 60)
    logger.info("Phase 1: Fetching data sources in parallel")
    logger.info("=" * 60)

    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        nvd_future = pool.submit(fetch_nvd_parallel, args.nvd_days, api_key, args.workers)
        kev_future = pool.submit(fetch_cisa_kev)
        epss_future = pool.submit(fetch_epss)

        nvd_pages = nvd_future.result()
        kev_future.result()
        epss_future.result()

    fetch_time = time.time() - start_time
    logger.info("Fetch complete in %.1fs", fetch_time)

    # ── Phase 2: Convert to platform format ──
    logger.info("=" * 60)
    logger.info("Phase 2: Converting to platform format")
    logger.info("=" * 60)

    flatten_nvd(nvd_pages)
    convert_kev()
    convert_epss()
    generate_cms_map()
    generate_compliance_map()

    # ── Phase 3: CVEDetails enrichment (optional) ──
    if not args.skip_cvedetails:
        logger.info("=" * 60)
        logger.info("Phase 3: CVEDetails.com enrichment")
        logger.info("=" * 60)

        nvd_file = OUT_DIR / "nvd_cpe_cve.json"
        cd_cache = OUT_DIR / "cvedetails_cvss.json"

        if nvd_file.exists():
            with open(nvd_file) as f:
                nvd_data = json.load(f)
            cve_ids = [e["cve"] for e in nvd_data if e.get("cve", "").startswith("CVE-")]

            # Load existing cache
            existing = {}
            if cd_cache.exists():
                try:
                    with open(cd_cache) as f:
                        existing = json.load(f)
                except Exception:
                    pass

            # Only fetch new CVEs
            new_cves = [c for c in cve_ids if c not in existing]
            if args.cvedetails_max:
                new_cves = new_cves[:args.cvedetails_max]

            if new_cves:
                delay = 0.5 if cd_api_key else 2.0
                new_results = fetch_cvedetails_parallel(
                    new_cves, cd_api_key, args.cvedetails_workers, delay
                )
                existing.update(new_results)

                with open(cd_cache, "w") as f:
                    json.dump(existing, f, indent=2)
                logger.info("CVEDetails cache: %d total entries -> %s", len(existing), cd_cache)
            else:
                logger.info("All %d CVEs already cached in CVEDetails", len(cve_ids))
        else:
            logger.warning("Skipping CVEDetails — nvd_cpe_cve.json not found")

    # ── Done ──
    total_time = time.time() - start_time
    logger.info("=" * 60)
    logger.info("All done in %.1fs", total_time)
    logger.info("=" * 60)

    # Summary
    for name in ["nvd_cpe_cve.json", "cisa_kev.json", "epss.json", "cms_cve_map.json", "compliance_map.json", "cvedetails_cvss.json"]:
        p = OUT_DIR / name
        if p.exists():
            size = p.stat().st_size
            if size > 1024 * 1024:
                logger.info("  %s: %.1f MB", name, size / 1024 / 1024)
            else:
                logger.info("  %s: %.1f KB", name, size / 1024)


if __name__ == "__main__":
    main()